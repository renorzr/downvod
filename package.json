{
    "name": "@renorzr/downvod",
    "version": "0.0.2",
    "description": "Download HLS video segments from m3u8 playlists or supported video pages and merge them with FFmpeg.",
    "author": "Reno Ren",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/renorzr/downvod.git"
    },
    "homepage": "https://github.com/renorzr/downvod#readme",
    "bugs": {
        "url": "https://github.com/renorzr/downvod/issues"
    },
    "keywords": [
        "hls",
        "m3u8",
        "video",
        "download",
        "ffmpeg",
        "cli"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "engines": {
        "node": ">=22"
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "axios": "^1.2.5",
        "html-dom-parser": "^3.1.3",
        "jsdom": "^21.1.0",
        "m3u8-parser": "^6.0.0",
        "yaml": "^2.2.1"
    },
    "devDependencies": {
        "@types/jsdom": "^20.0.1",
        "@types/node": "^22.10.0",
        "typescript": "^5.7.3"
    },
    "main": "./dist/index.js",
    "bin": {
        "downvod": "./dist/index.js",
        "batchdownvod": "./dist/batch.js"
    },
    "scripts": {
        "build": "tsc",
        "test": "npm run build && node --test test/*.test.js",
        "prepare": "npm run build"
    }
}
